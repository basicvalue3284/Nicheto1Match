# Copy this file to .env for local development. NEVER commit .env to git.
APP_USER=admin
APP_PASS=changeme

# Required for automatic extraction + policy checks.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
AI_PROVIDER=openai
BATCH_SIZE=25

# Required for Step 3 title scraping.
RAPIDAPI_KEY=

# Optional. Local default is ./data. Vercel default is /tmp/nicheto1match/data.
DATA_ROOT=

# Future sessions may add these:
# GOOGLE_PROJECT_ID=
# GCS_BUCKET=
