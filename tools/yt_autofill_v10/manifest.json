{
  "manifest_version": 3,
  "name": "YT AutoFill",
  "version": "10.0.0",
  "description": "Auto-fills YouTube Studio metadata with batch manifest and schedule guidance.",
  "permissions": ["activeTab", "scripting", "storage", "clipboardWrite", "sidePanel", "tabs"],
  "host_permissions": ["https://studio.youtube.com/*"],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://studio.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
